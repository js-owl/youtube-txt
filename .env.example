# Скопируйте этот файл в `.env.local` и подставьте свои ключи.
# Реальный `.env.local` уже в `.gitignore` и не попадёт в коммиты.

# Ключ Supadata: https://supadata.ai
SUPADATA_API_KEY=

# Ключ Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Supabase (Auth + кредиты) ===
# Берём из Dashboard → Settings → API
# URL проекта
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (новый формат, начинается с sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
